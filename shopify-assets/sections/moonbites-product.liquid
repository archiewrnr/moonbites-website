  <!-- REVIEWS -->
  <section class="pdp-reviews section" id="reviews">
    <div class="wave-divider wave-divider--top wave-divider--dark" aria-hidden="true">
      <svg viewBox="0 0 1440 120" preserveAspectRatio="none">
