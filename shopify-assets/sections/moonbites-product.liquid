  <!-- QUALITY YOU CAN TRUST -->
  <section class="trust-badges trust-badges--light section">
    <div class="wave-divider wave-divider--top wave-divider--light" aria-hidden="true">
      <svg viewBox="0 0 1440 120" preserveAspectRatio="none">
        <path class="wave-divider__soft" d="M0,60 C90,15 150,15 240,60 C330,105 390,105 480,60 C570,15 630,15 720,60 C810,105 870,105 960,60 C1050,15 1110,15 1200,60 C1290,105 1350,105 1440,60 L1440,120 L0,120 Z"></path>
        <path class="wave-divider__fill" d="M0,75 C90,35 150,35 240,75 C330,115 390,115 480,75 C570,35 630,35 720,75 C810,115 870,115 960,75 C1050,35 1110,35 1200,75 C1290,115 1350,115 1440,75 L1440,120 L0,120 Z"></path>
      </svg>
    </div>
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Quality You Can Trust</span>
        <h2>Made Properly, <em>Tested Thoroughly</em></h2>
      </div>
      <div class="trust-badges__grid">
        <div class="trust-badge"><span class="trust-badge__icon">🇬🇧</span><div><strong>Made in UK</strong><span>Manufactured to GMP standards</span></div></div>
        <div class="trust-badge"><span class="trust-badge__icon">🧪</span><div><strong>Third-Party Tested</strong><span>Every batch verified</span></div></div>
        <div class="trust-badge"><span class="trust-badge__icon">🌿</span><div><strong>Vegan &amp; Non-GMO</strong><span>No artificial fillers</span></div></div>
        <div class="trust-badge"><span class="trust-badge__icon">🚫</span><div><strong>Gluten-Free</strong><span>0g added sugar</span></div></div>
