{%- liquid
    assign current_variant = product.selected_or_first_available_variant
    assign compare_price = current_variant.compare_at_price
    assign gallery_images = product.images
    assign hero_image = gallery_images | where: "alt", "MoonBites campfire lakeside hero" | first
    assign hero_image = hero_image | default: gallery_images.first | default: product.featured_image
    assign title_words = product.title | default: "MoonBites Sleep Gummies" | split: " "
    assign title_first = title_words | first
    assign title_rest = title_words | slice: 1, 10 | join: " "
    assign triple_product = all_products['moonbites-sleep-gummies-1']
    assign triple_variant = triple_product.selected_or_first_available_variant
  -%}

  <!-- CINEMATIC PDP HERO -->
  <section class="hero hero--fullbleed hero--pdp">
    <img src="{% if hero_image %}{{ hero_image | image_url: width: 1800 }}{% else %}https://cdn.shopify.com/s/files/1/1021/6305/4979/files/hero-bedside.png?v=1784648105{% endif %}" alt="{{ product.title | escape }}" class="hero__bleed-img" />
    <div class="hero__scrim"></div>
    <div class="hero__content">
      <span class="hero__badge">✦ Melatonin-Free ✦ UK Based Brand ✦ Formulated By Experts</span>
      <h1 class="hero__headline">{{ title_first }}<br /><em>{{ title_rest }}</em></h1>
      <p class="hero__sub">Strawberry Chamomile · Botanical Night Blend. The gummies thousands of members build their nightly ritual around — melatonin-free, expertly formulated, and backed by a 30-night guarantee.</p>
      <div class="hero__cta">
        <a href="#plan" class="btn btn--primary btn--lg">Get MoonBites</a>
        <a href="#pdp-faq" class="btn btn--ghost btn--lg">Questions?</a>
      </div>
      <div class="hero__trust">
        <div class="trust-pill">⭐⭐⭐⭐⭐ 4.9/5 · 3,200+ members</div>
        <div class="trust-pill">✓ 30-Night Guarantee</div>
        <div class="trust-pill">✓ Free Shipping £40+</div>
      </div>
    </div>
    <div class="hero__wave">
      <svg class="hero__wave-svg" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
        <path class="hero__wave-soft" d="M0,60 C90,15 150,15 240,60 C330,105 390,105 480,60 C570,15 630,15 720,60 C810,105 870,105 960,60 C1050,15 1110,15 1200,60 C1290,105 1350,105 1440,60 L1440,120 L0,120 Z"></path>
        <path class="hero__wave-path" d="M0,75 C90,35 150,35 240,75 C330,115 390,115 480,75 C570,35 630,35 720,75 C810,115 870,115 960,75 C1050,35 1110,35 1200,75 C1290,115 1350,115 1440,75 L1440,120 L0,120 Z"></path>
      </svg>
    </div>
  </section>

  <!-- GALLERY + PURCHASE PANEL -->
  <section class="pdp-hero">
    <canvas id="starsCanvas"></canvas>
    <div class="container pdp-hero__grid">

      <!-- GALLERY -->
      <div class="pdp-gallery">
        <div class="pdp-gallery__badge">✦ Melatonin-Free ✦ UK Formulated</div>
        <div class="pdp-gallery__main">
          <img id="pdpMainImage" src="{% if gallery_images.size > 0 %}{{ gallery_images.first | image_url: width: 900 }}{% else %}https://cdn.shopify.com/s/files/1/1021/6305/4979/files/moonbites-product-1.jpg?v=1781468045{% endif %}" alt="{{ product.title | escape }}" />
          <span class="pdp-gallery__glow"></span>
        </div>
        <div class="pdp-gallery__thumbs" id="pdpThumbs">
          {%- if gallery_images.size > 0 -%}
            {%- for image in gallery_images limit: 6 -%}
              <button class="pdp-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-full="{{ image | image_url: width: 900 }}">
                <img src="{{ image | image_url: width: 160 }}" alt="{{ product.title | escape }} view {{ forloop.index }}" />
              </button>
            {%- endfor -%}
          {%- else -%}
            <button class="pdp-gallery__thumb is-active" data-full="https://cdn.shopify.com/s/files/1/1021/6305/4979/files/moonbites-product-1.jpg?v=1781468045"><img src="https://cdn.shopify.com/s/files/1/1021/6305/4979/files/moonbites-product-1.jpg?v=1781468045" alt="" /></button>
            <button class="pdp-gallery__thumb" data-full="https://cdn.shopify.com/s/files/1/1021/6305/4979/files/hero-bedside.png?v=1784648105"><img src="https://cdn.shopify.com/s/files/1/1021/6305/4979/files/hero-bedside.png?v=1784648105" alt="" /></button>
            <button class="pdp-gallery__thumb" data-full="https://d8j0ntlcm91z4.cloudfront.net/user_30R3eXL6BPUSKw0spLsPfz6tg4K/hf_20260722_155412_3cf28978-9581-43b3-86c6-482b076096be.png"><img src="https://d8j0ntlcm91z4.cloudfront.net/user_30R3eXL6BPUSKw0spLsPfz6tg4K/hf_20260722_155412_3cf28978-9581-43b3-86c6-482b076096be.png" alt="" /></button>
            <button class="pdp-gallery__thumb" data-full="https://d8j0ntlcm91z4.cloudfront.net/user_30R3eXL6BPUSKw0spLsPfz6tg4K/hf_20260722_155415_d99c5d1f-4250-4aa6-b92f-c790ae3eede7.png"><img src="https://d8j0ntlcm91z4.cloudfront.net/user_30R3eXL6BPUSKw0spLsPfz6tg4K/hf_20260722_155415_d99c5d1f-4250-4aa6-b92f-c790ae3eede7.png" alt="" /></button>
          {%- endif -%}
        </div>
        <div class="pdp-trust-row">
          <span>🇬🇧 Made in the UK</span>
          <span>🧪 Third-Party Tested</span>
          <span>🌿 Vegan &amp; Non-GMO</span>
        </div>
      </div>

      <!-- PURCHASE PANEL -->
      <div class="pdp-info">
        <div class="pdp-info__rating">
          <span>⭐⭐⭐⭐⭐</span>
          <strong>4.9/5</strong>
          <span>· 3,200+ verified reviews</span>
        </div>

        <h1 class="pdp-info__title">{{ product.title | default: "MoonBites Sleep Gummies" }}</h1>
        <p class="pdp-info__tagline">Melatonin-free · Botanical Night Blend · Formulated by sleep experts</p>

        <div class="pdp-info__price">
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <s class="pdp-info__price-old">{{ current_variant.compare_at_price | money }}</s>
          {%- endif -%}
          <span class="pdp-info__price-now" id="pdpPrice">{{ current_variant.price | default: 2999 | money }}</span>
          <span class="pdp-info__price-note">one-time · or less with membership</span>
        </div>

        <p class="pdp-info__desc">{{ product.description | strip_html | split: '🌙' | first | strip | truncatewords: 40 | default: "MoonBites are melatonin-free sleep gummies crafted with Magnesium Glycinate, KSM-66® Ashwagandha and L-Theanine to help you fall asleep faster, stay asleep longer, and wake up genuinely refreshed — no grogginess, no dependency." }}</p>

        <div class="pdp-benefits">
          <div class="pdp-benefit"><span>💤</span>Fall Asleep Faster</div>
          <div class="pdp-benefit"><span>🧠</span>Calm a Racing Mind</div>
          <div class="pdp-benefit"><span>🌊</span>Deeper Sleep Cycles</div>
          <div class="pdp-benefit"><span>☀️</span>Wake Restored</div>
          <div class="pdp-benefit"><span>🌿</span>Botanical Blend</div>
          <div class="pdp-benefit"><span>🔬</span>UK-Formulated</div>
        </div>

        <div class="pdp-plans" id="plan">
          <span class="pdp-plans__label">Choose your option</span>

          {%- assign allocation = current_variant.selling_plan_allocations.first -%}
          {%- assign selling_plan = allocation.selling_plan -%}
          {%- assign variant_price = current_variant.price | default: 2999 -%}
          {%- assign sub_price = allocation.price | default: variant_price -%}
          {%- assign triple_price = triple_variant.price -%}
          {%- assign triple_per_tub = triple_price | divided_by: 3.0 | round -%}
          {%- assign triple_pct_off = 0 -%}
          {%- if triple_price and variant_price > 0 -%}
            {%- assign triple_full_price = variant_price | times: 3 -%}
            {%- assign triple_pct_off = triple_full_price | minus: triple_price | times: 100.0 | divided_by: triple_full_price | round -%}
          {%- endif -%}

          {%- if selling_plan -%}
            <label class="plan-card" data-price="{{ sub_price }}" data-oldprice="{{ variant_price }}" data-qty="1" data-variant="{{ current_variant.id }}" data-selling-plan="{{ selling_plan.id }}">
              <input type="radio" name="pdp-plan" />
              <span class="plan-card__badge">RECOMMENDED</span>
              <div class="plan-card__main">
                <div class="plan-card__left">
                  <span class="plan-card__title">Subscribe &amp; Save</span>
                  <span class="plan-card__detail">{{ selling_plan.name }}</span>
                </div>
                <div class="plan-card__right">
                  <span class="plan-card__price"><s>{{ variant_price | money }}</s>{{ sub_price | money }}</span>
                  <span class="plan-card__off">20% OFF</span>
                </div>
              </div>
              <span class="plan-card__meta">Free gifts included · Cancel anytime</span>
            </label>
          {%- endif -%}

          {%- if triple_variant -%}
          <label class="plan-card plan-card--best" data-price="{{ triple_per_tub }}" data-oldprice="{{ variant_price }}" data-qty="1" data-variant="{{ triple_variant.id }}" data-selling-plan="">
            <input type="radio" name="pdp-plan" checked />
            <span class="plan-card__ribbon">⭐ BEST VALUE</span>
            <div class="plan-card__main">
              <div class="plan-card__left">
                <span class="plan-card__title">Buy 2, Get 1 FREE</span>
                <span class="plan-card__detail">3 Tubs · One-Time Purchase</span>
              </div>
              <div class="plan-card__right">
                <span class="plan-card__price"><s>{{ variant_price | money }}</s>{{ triple_per_tub | money }}<small>/tub</small></span>
                <span class="plan-card__off plan-card__off--gold">{{ triple_pct_off }}% OFF</span>
              </div>
            </div>
            <span class="plan-card__save">Save {{ triple_pct_off }}% — the membership's biggest saving</span>
          </label>
          {%- endif -%}

          <label class="plan-card" data-price="{{ variant_price }}" data-oldprice="" data-qty="1" data-variant="{{ current_variant.id }}" data-selling-plan="">
            <input type="radio" name="pdp-plan" />
            <div class="plan-card__main">
              <div class="plan-card__left">
                <span class="plan-card__title">One-Time Purchase</span>
                <span class="plan-card__detail">No commitment</span>
              </div>
              <div class="plan-card__right">
                <span class="plan-card__price">{{ variant_price | money }}</span>
              </div>
            </div>
            <span class="plan-card__meta">No membership perks included</span>
          </label>
        </div>

        <div class="pdp-gifts">
          <span class="pdp-gifts__label">FREE WITH YOUR MEMBERSHIP <em>Worth £160</em></span>
          <div class="gift-grid">
            <div class="gift-chip"><img src="https://cdn.shopify.com/s/files/1/1021/6305/4979/files/ritual-mask-light.png?v=1784648102" alt="Silk Sleep Mask" /><span>Silk Sleep Mask</span></div>
            <div class="gift-chip"><img src="https://cdn.shopify.com/s/files/1/1021/6305/4979/files/ritual-pillow-spray.png?v=1784648102" alt="MoonMist Pillow Spray" /><span>Pillow Spray</span></div>
            <div class="gift-chip"><span class="gift-chip__icon">📖</span><span>Sleep Guide Booklet</span></div>
            <div class="gift-chip"><span class="gift-chip__icon">🎧</span><span>Sleep Playlist</span></div>
          </div>
        </div>

        <form method="post" action="/cart/add" id="pdpForm" class="pdp-form">
          <input type="hidden" name="id" id="pdpVariantId" value="{{ triple_variant.id | default: current_variant.id | default: 58243240329603 }}" />
          <input type="hidden" name="selling_plan" id="pdpSellingPlan" value="" />
          <input type="hidden" name="quantity" id="pdpQuantity" value="1" />
          <button type="submit" class="btn btn--primary btn--xl pdp-cta" id="pdpCta">TRY RISK FREE • <span id="pdpCtaPrice">{{ triple_per_tub | money }}</span></button>
        </form>

        <div class="pdp-assure">
          <span>🚚 Free UK Shipping</span>
          <span>🛡️ 30-Day Money Back Guarantee</span>
          <span>🔒 Secure Checkout</span>
        </div>

        <div class="pdp-pay" aria-label="Accepted payment methods">
          <span class="pay-badge pay-badge--applepay">Apple Pay</span>
          <span class="pay-badge pay-badge--googlepay">Google Pay</span>
          <span class="pay-badge pay-badge--visa">Visa</span>
          <span class="pay-badge pay-badge--mastercard">Mastercard</span>
          <span class="pay-badge pay-badge--paypal">PayPal</span>
          <span class="pay-badge pay-badge--shoppay">Shop Pay</span>
        </div>

        <p class="pdp-live">🔥 <strong><span id="pdpViewerCount">37</span> people</strong> are viewing this right now</p>
        <p class="pdp-stock">⚡ Only <strong id="pdpStockCount">14</strong> left in stock at this price</p>
      </div>
    </div>
  </section>

  <!-- INGREDIENTS -->
  <section class="pdp-ingredients section" id="ingredients">
    <div class="wave-divider wave-divider--top wave-divider--dark" aria-hidden="true">
      <svg viewBox="0 0 1440 120" preserveAspectRatio="none">
        <path class="wave-divider__soft" d="M0,60 C90,15 150,15 240,60 C330,105 390,105 480,60 C570,15 630,15 720,60 C810,105 870,105 960,60 C1050,15 1110,15 1200,60 C1290,105 1350,105 1440,60 L1440,120 L0,120 Z"></path>
        <path class="wave-divider__fill" d="M0,75 C90,35 150,35 240,75 C330,115 390,115 480,75 C570,35 630,35 720,75 C810,115 870,115 960,75 C1050,35 1110,35 1200,75 C1290,115 1350,115 1440,75 L1440,120 L0,120 Z"></path>
